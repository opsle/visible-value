#!/usr/bin/env bash
# Canonical TEST stage for opsle/visible-value. GitHub Actions and agents run this same command.
#   ops/ci/test
set -Eeuo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."

step() { printf '\n==> %s\n' "$*"; }

step "Run test suite"
npm test

step "Test CLI entry point"
node bin/visible-value.js summarize examples/run.json >/dev/null
